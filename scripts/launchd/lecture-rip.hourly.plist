<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>home.lecture-rip.hourly</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/lecture-rip</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/bun</string>
    <string>run</string>
    <string>src/index.ts</string>
  </array>

  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/lecture-rip/logs/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/lecture-rip/logs/launchd.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
