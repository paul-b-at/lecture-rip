# Notion
NOTION_TOKEN=
LECTURES_DS_ID=
SUBJECTS_DS_ID=

# Notion property names (must match your DB **exactly**, case-sensitive). Defaults target the English template.
# If the API errors with "X is not a property", run once: the pipeline prints all real column titles after validateLecturesDatabaseConfig.
# When NOTION_* is unset / empty (e.g. no GitHub secret), the runner auto-matches common JKU Lectures titles: JKU Lecture ID, relation «Subjects», «Source URL».
# NOTION_LECTURES_NAME=Name
# NOTION_LECTURES_LECTURE_ID=Lecture ID
# NOTION_LECTURES_COURSE_SUBJECT=Course ID   # or Subjects, Relation → Subjects DB
# NOTION_LECTURES_SUBJECT_KIND=relation   # when that column is a Relation to Subjects (not rich_text UUID)
# NOTION_LECTURES_MEDIA_URL=Moodle URL
# NOTION_LECTURES_STATUS=Status
# NOTION_LECTURES_SKIP_REASON=Skip Reason
# NOTION_SUBJECTS_MEDIA_COURSE_ID=Media Course ID
# NOTION_SUBJECTS_MEDIA_SERIES_ID=Media Series ID
# NOTION_SUBJECTS_GLOSSARY=Glossary

# Groq (transcription)
GROQ_API_KEY=
# Decoded audio cap per **UTC hour** (`.cache/budget.json`; aligns with hourly GitHub cron). Default 7200 ≈ 2h lecture audio per UTC hour.
GROQ_HOURLY_AUDIO_SECONDS=7200
# Legacy alias (same meaning as hourly cap for this field):
# GROQ_DAILY_AUDIO_SECONDS=7200
# Groq Whisper `transcriptions.create` calls per UTC day (each chunk + each 429 retry counts as one).
# GROQ_DAILY_REQUESTS=200
# Optional milliseconds between chunked API calls — reduces TPM/burst 429s on large files.
# GROQ_INTER_CHUNK_MS=400

# Gemini (postprocessing)
GEMINI_API_KEY=
# Gemini `generateContent` calls per UTC day (schema-validation retry + model fallback each count).
# GEMINI_DAILY_REQUESTS=500

# Notifications (GitHub Actions only — workflow failure ping)
NTFY_TOPIC=

# media.jku.at OpenCast (optional — defaults shown)
MEDIA_BASE_URL=https://media.jku.at

# Logged-in browser Cookie header value for requests to MEDIA_BASE_URL (optional).
# Needed when `/search/` hides your course anonymously (same ACL as Paella's `/search/episode.json?id=…`).
# Treat like a password — never commit real values or put long-lived secrets in CI logs.
MEDIA_SESSION_COOKIE=

# Playwright login flow (alternative to MEDIA_SESSION_COOKIE). After `bun run media:login`, point here.
# Stored under .cache/ by default (.gitignored). Never commit a real storage state JSON.
MEDIA_PLAYWRIGHT_STATE=.cache/jku-media-storage.json

# Override start URL for the login script only (defaults to MEDIA_BASE_URL)
# MEDIA_LOGIN_URL=https://media.jku.at/

# semester tag as in Opencast series title: 2026S or 2025W; leave unset to auto from calendar
MEDIA_SEMESTER=

# IANA timezone for “today” when inferring semester (CI uses UTC clocks). Default Europe/Vienna ≈ JKU term.
# MEDIA_SEMESTER_TZ=Europe/Vienna

# Opt-in LU substring resolution when `/search/` is sparse (risk: wrong semester). Omit or false normally.
# MEDIA_RESOLVE_LOOSE_LU=true

# When LU-only: allow older OpenCast terms (e.g. 2025W) if current anchor (e.g. 2026S) has no matching series. Default off.
# MEDIA_LU_ALLOW_OLDER_SEM_FALLBACK=true

COURSE_FILTER=
FORCE_RERIP=false
